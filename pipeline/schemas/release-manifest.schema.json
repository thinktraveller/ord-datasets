{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-reaction-database.github.io/ord-datasets/schemas/1.0.0/release-manifest.schema.json",
  "title": "ord-datasets release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "release_status", "project_commit", "ord_upstream_revision", "source_manifest_path", "source_manifest_sha256", "contract_versions", "counts", "license", "artifact_inventory_path", "transformations_path", "lineage_edges_path", "root_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_id": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "release_status": {"enum": ["draft", "release-candidate", "released", "withdrawn"]},
    "project_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ord_upstream_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_manifest_path": {"const": "provenance/source-files.initial.csv"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_versions": {"type": "object", "additionalProperties": false, "required": ["catalog", "metadata", "source_links", "artifact_inventory", "row_map", "transformation", "release_manifest", "csv_contracts"], "properties": {"catalog": {"const": "1.0.0"}, "metadata": {"const": "1.0.0"}, "source_links": {"const": "1.0.0"}, "artifact_inventory": {"const": "1.0.0"}, "row_map": {"const": "1.0.0"}, "transformation": {"const": "1.0.0"}, "release_manifest": {"const": "1.0.0"}, "csv_contracts": {"enum": ["1.0.0", "1.1.0"]}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["physical_sources", "logical_corpora", "model_ready_targets", "release_files", "total_bytes"], "properties": {"physical_sources": {"const": 53}, "logical_corpora": {"const": 41}, "model_ready_targets": {"const": 19}, "release_files": {"type": "integer", "minimum": 0}, "total_bytes": {"type": "integer", "minimum": 0}}},
    "license": {"type": "object", "additionalProperties": false, "required": ["data_license_id", "code_license_id", "notice_path"], "properties": {"data_license_id": {"const": "CC-BY-SA-4.0"}, "code_license_id": {"const": "Apache-2.0"}, "notice_path": {"const": "NOTICE"}}},
    "artifact_inventory_path": {"const": "provenance/artifact-inventory.csv"},
    "transformations_path": {"const": "provenance/transformations.jsonl"},
    "lineage_edges_path": {"const": "provenance/lineage-edges.csv"},
    "root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
