{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-reaction-database.github.io/ord-datasets/schemas/1.0.0/transformation-record.schema.json",
  "title": "ord-datasets transformation graph record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transformation_id", "step_id", "tool", "pipeline_commit", "command", "config_sha256", "input_artifact_ids", "output_artifact_ids", "started_at", "ended_at", "status", "error_code"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "transformation_id": {"type": "string", "pattern": "^transform-[a-z0-9][a-z0-9-]*$"},
    "step_id": {"type": "string", "pattern": "^step-[0-9]{2}[a-z]?$"},
    "tool": {"type": "string", "minLength": 1},
    "pipeline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "command": {"type": "string", "minLength": 1, "not": {"pattern": "(?:^|\\s)/(?:home|tmp|var)/"}},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "output_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["complete", "failed", "blocked"]},
    "error_code": {"type": ["string", "null"], "pattern": "^[A-Z0-9_]+$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "complete"}}}, "then": {"properties": {"error_code": {"const": null}}}},
    {"if": {"properties": {"status": {"enum": ["failed", "blocked"]}}}, "then": {"properties": {"error_code": {"type": "string", "minLength": 1}}}}
  ]
}
