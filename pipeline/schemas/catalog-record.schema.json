{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-reaction-database.github.io/ord-datasets/schemas/1.0.0/catalog-record.schema.json",
  "title": "ord-datasets catalog record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "dataset_slug", "display_name_en", "logical_dataset_id", "physical_dataset_ids", "physical_source_files", "target_id", "label_type", "label_unit", "readiness_status", "artifact_status", "license_id", "row_count", "content_sha256", "release_path", "metadata_path", "source_links_path"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"enum": ["corpus", "model-ready"]},
    "dataset_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "display_name_en": {"type": "string", "minLength": 1},
    "display_name_zh": {"type": ["string", "null"], "minLength": 1},
    "logical_dataset_id": {"type": "string", "pattern": "^(?:lit|physical|upstream)_[a-z0-9_]+$"},
    "physical_dataset_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ord_dataset-[0-9a-f]{32}$"}},
    "physical_source_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^data/[0-9a-f]{2}/ord_dataset-[0-9a-f]{32}\\.parquet$"}},
    "target_id": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "label_type": {"type": ["string", "null"], "enum": [null, "reaction_yield_percent", "conversion_percent", "relative_lc_area_ratio", "hplc_response_percent", "lc_uv_area_percent", "signed_enantiomeric_excess_s_minus_r_percent"]},
    "label_unit": {"type": ["string", "null"], "minLength": 1},
    "readiness_status": {"enum": ["complete_corpus_pending_release_validation", "active_generated_pending_release_validation", "generated_pending_campaign_evaluation", "partial_scope_generated", "research_only_benchmark_blocked", "generated_adapter_blocked", "generated_with_source_caveat", "release_blocked", "released"]},
    "artifact_status": {"enum": ["planned", "staged", "validated", "released", "blocked"]},
    "license_id": {"const": "CC-BY-SA-4.0"},
    "row_count": {"type": "integer", "minimum": 0},
    "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "release_path": {"type": "string", "pattern": "^datasets/(?:corpus|model-ready)/[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "metadata_path": {"type": "string", "pattern": "^datasets/(?:corpus|model-ready)/[a-z0-9]+(?:-[a-z0-9]+)*/metadata\\.json$"},
    "source_links_path": {"type": "string", "pattern": "^datasets/(?:corpus|model-ready)/[a-z0-9]+(?:-[a-z0-9]+)*/source-links\\.json$"}
  },
  "allOf": [
    {"if": {"properties": {"record_type": {"const": "corpus"}}}, "then": {"properties": {"target_id": {"const": null}, "label_type": {"const": null}, "label_unit": {"const": null}, "release_path": {"pattern": "^datasets/corpus/"}, "metadata_path": {"pattern": "^datasets/corpus/"}, "source_links_path": {"pattern": "^datasets/corpus/"}}}},
    {"if": {"properties": {"record_type": {"const": "model-ready"}}}, "then": {"required": ["target_id"], "properties": {"target_id": {"type": "string", "minLength": 1}, "label_type": {"type": "string"}, "label_unit": {"type": "string"}, "release_path": {"pattern": "^datasets/model-ready/"}, "metadata_path": {"pattern": "^datasets/model-ready/"}, "source_links_path": {"pattern": "^datasets/model-ready/"}}}}
  ]
}
